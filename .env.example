# Copie pra .env (git-ignored) e preencha antes de `docker compose up`.

# Game Server Login Token — gere em https://steamcommunity.com/dev/managegameservers
# (escolha o app "Counter-Strike 2 (Dedicated Server)")
SRCDS_TOKEN=

# Senha do RCON do servidor Docker — pode ser qualquer valor local, só
# não reaproveite senha real de outro serviço.
CS2_RCONPW=CHANGE_ME_LOCAL_ONLY

# Seu SteamID64 (pegue em https://steamid.io colando o link do seu
# perfil Steam) — mesmo valor usado em docker/match_config.spike.json.
# Vira admin automático no MatchZy (.start/.forceready funcionam sem
# precisar editar admins.json na mão).
MATCHZY_ADMINS=
